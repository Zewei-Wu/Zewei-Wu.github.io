  {%- elif name == "camera" -%}
  <path fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" d="M3.2 8.6A1.6 1.6 0 0 1 4.8 7h2.6l1.3-2h6.6l1.3 2h2.6a1.6 1.6 0 0 1 1.6 1.6v9.2a1.6 1.6 0 0 1-1.6 1.6H4.8a1.6 1.6 0 0 1-1.6-1.6z"/>
  <circle cx="12" cy="13" r="3.4" fill="none" stroke="currentColor" stroke-width="1.7"/>
  {%- elif name == "palette" -%}
  <path fill="none" stroke="currentColor" stroke-width="1.7" d="M12 3.2a8.8 8.8 0 0 0 0 17.6c1.3 0 1.9-.8 1.9-1.7 0-.9-.6-1.5-.6-2.3 0-.9.7-1.6 1.7-1.6h1.6a4.2 4.2 0 0 0 4.2-4.2c0-4.3-4-7.8-8.8-7.8"/>
